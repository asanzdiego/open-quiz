PORT=3000
NODE_ENV=development

# Opcional: origen público exacto, sin barra final, para restringir el handshake.
# PUBLIC_ORIGIN=https://quiz.example.com

# Capacidades en memoria (sesiones incluyen las terminadas hasta su TTL).
MAX_ACTIVE_SESSIONS=50
MAX_PARTICIPANTS_PER_SESSION=100
MAX_CONNECTIONS=1000

# Rellena las tres variables para poder crear partidas desde el navegador.
# URL WebDAV de la cuenta, por ejemplo https://cloud.example.com/remote.php/dav/files/docente/
# Credenciales exclusivamente del backend. Utiliza una contraseña de aplicación.
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_REQUEST_TIMEOUT_MS=15000

# Duración entre 1 y 3600 segundos; máximo entre 1 y 1000000 puntos.
DEFAULT_QUESTION_DURATION_SECONDS=20
MAX_POINTS_PER_QUESTION=1000

# Limpieza de sesiones en memoria, comprobada cada minuto.
SESSION_TTL_MINUTES=120
FINISHED_SESSION_TTL_MINUTES=30
